{
  "version": 2,
  "functions": {
    "api/extract-audio.py": {
      "runtime": "vercel-python@0.0.0",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/extract-audio",
      "dest": "api/extract-audio.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
